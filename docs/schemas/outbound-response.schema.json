{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:company:order-api-b:outbound-response:0.1.0",
  "title": "Order API B outbound response",
  "type": "object",
  "required": ["body", "timestamp", "signature"],
  "properties": {
    "body": {
      "type": "object",
      "required": ["order_id", "customer_id", "amount", "currency"],
      "properties": {
        "order_id": {"type": "string"},
        "customer_id": {"type": "string"},
        "amount": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{2}$"},
        "currency": {"type": "string", "enum": ["CNY", "HKD", "USD"]}
      },
      "additionalProperties": false
    },
    "timestamp": {"type": "integer"},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}

